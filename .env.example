HTTP_PORT=8100
# Your timezone (IANA name), used for "today" and the 4 pm notification
TZ=America/Phoenix
# Public ntfy.sh topic - pick something hard to guess, then subscribe to it in the ntfy app
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=change-me-vac-dashboard
# Hour (0-23, local time) the daily reminder is sent
NOTIFY_HOUR=16
# Icon for the Unraid Docker tab; the app serves it, so use your server address:
ICON_URL=http://YOUR-SERVER-IP:8100/icon.png
